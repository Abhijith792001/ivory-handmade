# ── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ivoryhandmade.in
# WhatsApp number in international format, digits only (91 = India)
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
# City shown in the "Free delivery in ..." banner (leave empty to hide)
NEXT_PUBLIC_FREE_DELIVERY_CITY=Kochi
NEXT_PUBLIC_FREE_DELIVERY_MIN=999
NEXT_PUBLIC_DELIVERY_FEE=80
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/ivory.handmade
NEXT_PUBLIC_CONTACT_EMAIL=hello@ivoryhandmade.in

# ── Supabase ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Comma separated list of emails allowed into /admin
ADMIN_EMAILS=owner@ivoryhandmade.in

# ── Razorpay ───────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Optional: Razorpay webhook secret (Dashboard → Webhooks → payment.captured → /api/razorpay/webhook)
RAZORPAY_WEBHOOK_SECRET=

# Optional: a modelled gift-box base (no lid) used by the 3D builder for every box size.
# e.g. /models/gift-box.glb (put the file in public/models). A per-box GLB set in /admin takes priority.
NEXT_PUBLIC_GIFT_BOX_GLB=
